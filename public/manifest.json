{
  "manifest_version": 3,
  "name": "Reinbox",
  "version": "0.1.0",
  "description": "Bring the Google Inbox experience back to Gmail. Open source.",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
